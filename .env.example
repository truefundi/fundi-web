# Fundi Web Environment Variables
# Copy this file to .env and adjust values for your machine.
# NEXT_PUBLIC_* variables are exposed to the browser: never put secrets in them.

# Browser API path, forwarded by Next.js to API_PROXY_TARGET
NEXT_PUBLIC_API_URL=/api/v1

# Display name used across the admin portal
NEXT_PUBLIC_APP_NAME=Fundi Platform

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Set true only for demonstration data
NEXT_PUBLIC_USE_MOCKS=false

# Server-only backend origin (without /api/v1)
API_PROXY_TARGET=http://localhost:3000
